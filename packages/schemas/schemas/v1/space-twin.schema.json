{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sajao.app/v1/space-twin.schema.json",
  "title": "SpaceTwin",
  "description": "The 3D digital twin of a scanned space: the room shell and every object as its own editable item. Built from one immutable capture; a new reconstruction is a new version, and edits are deltas kept outside the twin. Every dimension carries a value, a source and an error band; generated 3D models never set an object's size, the measured box does. The space frame is metric: x and y on the floor (as in SpaceProfile), z up from the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "capture_id",
    "version",
    "created_at",
    "space_type",
    "space_type_source",
    "extent",
    "extent_source",
    "shell",
    "objects",
    "keyframes",
    "scale",
    "direction"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "capture_id": {
      "$ref": "common.schema.json#/$defs/Uuid",
      "description": "The capture this twin was built from. The capture never changes."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Reconstruction version for this capture. Designs reference a twin id and version."
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "space_type": {
      "$ref": "common.schema.json#/$defs/SpaceType"
    },
    "space_type_source": {
      "$ref": "common.schema.json#/$defs/DetectionSource"
    },
    "extent": {
      "type": "string",
      "enum": ["whole_room", "part"]
    },
    "extent_source": {
      "$ref": "common.schema.json#/$defs/DetectionSource"
    },
    "shell": {
      "$ref": "#/$defs/Shell"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TwinObject"
      },
      "description": "Every object found in the space, each its own item."
    },
    "keyframes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Keyframe"
      },
      "minItems": 1,
      "description": "Sharp frames with camera poses and intrinsics, in the space frame."
    },
    "scale": {
      "$ref": "space-profile.schema.json#/$defs/ScaleEvidence"
    },
    "direction": {
      "$ref": "space-profile.schema.json#/$defs/SpaceDirection"
    },
    "splat": {
      "$ref": "#/$defs/SplatRef"
    },
    "phone_splats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhoneSplat"
      },
      "maxItems": 4,
      "description": "Compressed room splats for viewing on the phone, one per device tier. Colour only; built from the room splat."
    },
    "viewing": {
      "$ref": "#/$defs/Viewing"
    },
    "inventory": {
      "$ref": "#/$defs/Inventory"
    }
  },
  "$defs": {
    "Point3": {
      "description": "A point in the space frame, in metres. z is height above the floor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x_m", "y_m", "z_m"],
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "z_m": {
          "type": "number"
        }
      }
    },
    "Shell": {
      "description": "The room itself: floor, walls, ceiling, doors, windows and wall fixtures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["floor_polygon", "walls", "ceiling_height", "openings", "fixtures", "surfaces"],
      "properties": {
        "floor_polygon": {
          "$ref": "common.schema.json#/$defs/Polygon"
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "space-profile.schema.json#/$defs/Wall"
          },
          "minItems": 1
        },
        "ceiling_height": {
          "$ref": "common.schema.json#/$defs/Dimension"
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "space-profile.schema.json#/$defs/Opening"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "space-profile.schema.json#/$defs/Fixture"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShellSurface"
          },
          "description": "Appearance of each wall, the floor and the ceiling."
        },
        "built_ins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuiltIn"
          },
          "description": "Built-in items, kept with the shell."
        }
      }
    },
    "ShellSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId",
          "description": "A wall's id, or floor or ceiling."
        },
        "kind": {
          "type": "string",
          "enum": ["wall", "floor", "ceiling"]
        },
        "texture": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "Photo texture projected from the keyframes with objects masked out."
        },
        "material": {
          "$ref": "#/$defs/SurfaceMaterial"
        }
      }
    },
    "SurfaceMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["paint", "tile", "wood", "stone", "wallpaper", "other"]
        },
        "color": {
          "$ref": "common.schema.json#/$defs/HexColor"
        },
        "tile_size": {
          "$ref": "common.schema.json#/$defs/Dimension",
          "description": "Side of one tile, when the material is tile."
        },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog product for a restyle (paint or flooring)."
        }
      }
    },
    "OrientedBox": {
      "description": "An object's measured box: centre, turn about the vertical axis and size. Sizes are dimensions with a source and an error band.",
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "yaw_deg", "width", "depth", "height"],
      "properties": {
        "center": {
          "$ref": "#/$defs/Point3"
        },
        "yaw_deg": {
          "$ref": "common.schema.json#/$defs/AngleDeg"
        },
        "width": {
          "$ref": "common.schema.json#/$defs/Dimension"
        },
        "depth": {
          "$ref": "common.schema.json#/$defs/Dimension"
        },
        "height": {
          "$ref": "common.schema.json#/$defs/Dimension"
        }
      }
    },
    "TwinObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "label",
        "box",
        "detection",
        "views",
        "catalog_matches",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Machine class, for example sofa or almirah."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Name shown to the user, for example Grey three-seater sofa."
        },
        "box": {
          "$ref": "#/$defs/OrientedBox"
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "confidence"],
          "properties": {
            "source": {
              "type": "string",
              "enum": ["live_scan", "server_segmentation", "user"]
            },
            "confidence": {
              "$ref": "common.schema.json#/$defs/UnitScore"
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectView"
          },
          "description": "Masks and best crops from the keyframes that see this object."
        },
        "model": {
          "$ref": "#/$defs/ObjectModel"
        },
        "splat_subset": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "This object's part of the room splat."
        },
        "catalog_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogMatch"
          }
        },
        "state": {
          "type": "string",
          "enum": ["keep", "move", "remove", "replace"],
          "description": "keep in a freshly built twin. Edits change it only in a derived view, never in the stored twin."
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType",
          "description": "What kind of thing it is. Built-ins are not objects: they are in the shell's built_ins."
        }
      }
    },
    "ObjectView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframe_id", "mask", "crop"],
      "properties": {
        "keyframe_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "mask": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "crop": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        }
      }
    },
    "ObjectModel": {
      "description": "A 3D model made from the object's own crops. Scaled to the measured box; the model never sets the size.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "generator", "scaled_to_box"],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "generator": {
          "type": "string",
          "minLength": 1,
          "description": "Model name and pinned version that made it."
        },
        "scaled_to_box": {
          "const": true
        }
      }
    },
    "CatalogMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "similarity", "fits_box"],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "similarity": {
          "$ref": "common.schema.json#/$defs/UnitScore"
        },
        "fits_box": {
          "type": "boolean",
          "description": "The product's catalog size fits this object's box, with the error band as margin."
        }
      }
    },
    "Keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "captured_at_ms", "pose", "intrinsics"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "image": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "captured_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds from the start of the capture."
        },
        "pose": {
          "$ref": "#/$defs/CameraPose"
        },
        "intrinsics": {
          "$ref": "#/$defs/CameraIntrinsics"
        },
        "sharpness": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "CameraPose": {
      "description": "Camera position and orientation in the space frame. Rotation is a unit quaternion (x, y, z, w).",
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation"],
      "properties": {
        "position": {
          "$ref": "#/$defs/Point3"
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "CameraIntrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fx", "fy", "cx", "cy", "width_px", "height_px"],
      "properties": {
        "fx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cx": {
          "type": "number",
          "minimum": 0
        },
        "cy": {
          "type": "number",
          "minimum": 0
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "SplatRef": {
      "description": "The photoreal room splat trained on the keyframes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "format"],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "format": {
          "type": "string",
          "enum": ["ply", "spz", "ksplat"]
        }
      }
    },
    "PhoneSplat": {
      "description": "A decimated, compressed room splat for on-device viewing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "format", "tier", "gaussians", "bytes"],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "format": {
          "type": "string",
          "enum": ["sog"]
        },
        "tier": {
          "type": "string",
          "enum": ["capable", "budget"],
          "description": "capable: recent phones (500k Gaussians). budget: budget Android (250k)."
        },
        "gaussians": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Viewing": {
      "description": "Where the twin may be shown from. The room splat only holds up near where the phone stood, so the viewer and the reveal use only the hero views, their orbits, and camera positions inside the safe region.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_views", "safe_region"],
      "properties": {
        "hero_views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeroView"
          },
          "minItems": 1,
          "maxItems": 10,
          "description": "Six to ten views when the capture allows, best first."
        },
        "safe_region": {
          "$ref": "#/$defs/SafeRegion"
        }
      }
    },
    "HeroView": {
      "description": "A view the twin is shown from: the pose of a real keyframe, chosen by code for how much of the room it shows, its sharpness and its framing. Never a pose a model made up.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keyframe_id", "coverage", "sharpness", "orbit"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "keyframe_id": {
          "$ref": "common.schema.json#/$defs/LocalId",
          "description": "The keyframe whose pose, intrinsics and photo this view uses."
        },
        "coverage": {
          "$ref": "common.schema.json#/$defs/UnitScore",
          "description": "Share of the scanned room this view shows."
        },
        "sharpness": {
          "type": "number",
          "minimum": 0,
          "description": "Variance of the Laplacian of the keyframe; higher is sharper."
        },
        "orbit": {
          "$ref": "#/$defs/ViewOrbit"
        }
      }
    },
    "ViewOrbit": {
      "title": "ViewOrbit",
      "description": "How far the camera may move and turn around a hero view. Viewing limits, not room measurements.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_offset_m", "max_yaw_deg"],
      "properties": {
        "max_offset_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Largest distance of the camera from the hero pose, in metres."
        },
        "max_yaw_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "Largest turn about the vertical axis, either way."
        }
      }
    },
    "SafeRegion": {
      "title": "SafeRegion",
      "description": "Where the camera may stand: within radius_m of any anchor. Anchors are the keyframe camera positions along the capture path, in the space frame. A viewing limit, not a room measurement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "radius_m"],
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point3"
          },
          "minItems": 1
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "TwinEdit": {
      "description": "One change to a twin, kept outside it. Made by the user or the solver, never by a model. Undo is dropping the edit.",
      "oneOf": [
        {
          "$ref": "#/$defs/MoveEdit"
        },
        {
          "$ref": "#/$defs/RotateEdit"
        },
        {
          "$ref": "#/$defs/RemoveEdit"
        },
        {
          "$ref": "#/$defs/ReplaceEdit"
        },
        {
          "$ref": "#/$defs/AddEdit"
        },
        {
          "$ref": "#/$defs/RestyleSurfaceEdit"
        }
      ]
    },
    "MoveEdit": {
      "title": "MoveEdit",
      "description": "Move an object: its box centre moves, its measured size does not.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "object_id", "to"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "move"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "object_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "to": {
          "$ref": "#/$defs/Point3"
        }
      }
    },
    "RotateEdit": {
      "title": "RotateEdit",
      "description": "Turn an object about the vertical axis.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "object_id", "yaw_deg"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "rotate"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "object_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "yaw_deg": {
          "$ref": "common.schema.json#/$defs/AngleDeg"
        }
      }
    },
    "RemoveEdit": {
      "title": "RemoveEdit",
      "description": "Remove an object; the fill behind it is a render concern.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "object_id"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "remove"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "object_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        }
      }
    },
    "ReplaceEdit": {
      "title": "ReplaceEdit",
      "description": "Replace an object with a catalog product of the given size.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "object_id", "product_id", "product_size"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "replace"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "object_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "product_size": {
          "$ref": "#/$defs/ProductSize"
        }
      }
    },
    "AddEdit": {
      "title": "AddEdit",
      "description": "Add a catalog product at a pose.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "product_id", "product_size", "to", "yaw_deg", "label"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "add"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "product_size": {
          "$ref": "#/$defs/ProductSize"
        },
        "to": {
          "$ref": "#/$defs/Point3"
        },
        "yaw_deg": {
          "$ref": "common.schema.json#/$defs/AngleDeg"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "RestyleSurfaceEdit": {
      "title": "RestyleSurfaceEdit",
      "description": "Repaint or refloor a surface.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "by", "surface_id", "material"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "op": {
          "const": "restyle_surface"
        },
        "by": {
          "type": "string",
          "enum": ["user", "solver"],
          "description": "Who made the edit. Never a model."
        },
        "surface_id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "material": {
          "$ref": "#/$defs/SurfaceMaterial"
        }
      }
    },
    "ProductSize": {
      "description": "A catalog product's size: retailer data, so measured or estimated, never set by a model.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": {
          "$ref": "common.schema.json#/$defs/Dimension"
        },
        "depth": {
          "$ref": "common.schema.json#/$defs/Dimension"
        },
        "height": {
          "$ref": "common.schema.json#/$defs/Dimension"
        }
      }
    },
    "TwinReference": {
      "description": "Which twin a design builds on, and the ordered edits it makes to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["twin_id", "twin_version", "edits"],
      "properties": {
        "twin_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "twin_version": {
          "type": "integer",
          "minimum": 1
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TwinEdit"
          }
        }
      }
    },
    "ObjectType": {
      "description": "The type of an item in the room.",
      "type": "string",
      "enum": ["furniture", "fixture", "wall_item", "textile", "decor"]
    },
    "BuiltIn": {
      "description": "Something built into the room (a fitted wardrobe, a fireplace, a radiator, a kitchen counter). Part of the shell: it stays when the room is redesigned.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "label", "box", "detection"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "box": {
          "$ref": "#/$defs/OrientedBox"
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "confidence"],
          "properties": {
            "source": {
              "type": "string",
              "enum": ["live_scan", "server_segmentation", "user"]
            },
            "confidence": {
              "$ref": "common.schema.json#/$defs/UnitScore"
            }
          }
        }
      }
    },
    "InventoryItem": {
      "description": "An item a vision model listed that could not be placed in 3D. Kept and shown, never dropped silently.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "listed_by", "tried", "reason"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["furniture", "fixture", "wall_item", "textile", "decor", "built_in"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "listed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Pinned models that listed it."
        },
        "tried": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Detector prompts and models tried to place it."
        },
        "reason": {
          "type": "string",
          "enum": ["not_detected", "not_seen_in_enough_frames", "no_depth", "implausible_size"]
        }
      }
    },
    "Inventory": {
      "description": "The open-vocabulary inventory the objects were found from, and what could not be placed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["listed_by", "items_listed", "unplaced"],
      "properties": {
        "listed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "items_listed": {
          "type": "integer",
          "minimum": 0
        },
        "unplaced": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryItem"
          }
        }
      }
    }
  }
}
