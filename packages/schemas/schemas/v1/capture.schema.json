{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sajao.app/v1/capture.schema.json",
  "title": "Capture",
  "description": "Input stage: the photos or video of any space, at any extent (a whole room, a corner, a balcony), plus optional tape values. The space type is detected later, not picked here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "user_id", "created_at", "media", "device"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "user_id": {
      "$ref": "common.schema.json#/$defs/Uuid",
      "description": "Owner. Guest sessions have a user id too."
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaptureMedia"
      },
      "minItems": 1,
      "maxItems": 40
    },
    "device": {
      "$ref": "#/$defs/CaptureDevice"
    },
    "compass": {
      "$ref": "#/$defs/CompassReading"
    },
    "tape_measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TapeMeasurement"
      }
    },
    "package": {
      "$ref": "#/$defs/CapturePackage"
    }
  },
  "$defs": {
    "CaptureMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "origin", "storage_key", "width_px", "height_px", "has_ar_pose"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "kind": {
          "type": "string",
          "enum": ["photo", "video"]
        },
        "origin": {
          "type": "string",
          "enum": ["camera", "gallery"]
        },
        "storage_key": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Video only."
        },
        "sharpness": {
          "$ref": "common.schema.json#/$defs/UnitScore",
          "description": "On-device sharpness check result."
        },
        "has_ar_pose": {
          "type": "boolean",
          "description": "True when an ARKit or ARCore pose is attached. Never required."
        },
        "compass_heading_deg": {
          "$ref": "common.schema.json#/$defs/AngleDeg"
        }
      }
    },
    "CaptureDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "tier", "has_ar"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["ios", "android"]
        },
        "tier": {
          "type": "string",
          "enum": ["standard", "low"],
          "description": "Device tier detected at launch."
        },
        "has_ar": {
          "type": "boolean"
        }
      }
    },
    "CompassReading": {
      "description": "Compass headings averaged across the capture, used for Vastu direction.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_heading_deg", "sample_count"],
      "properties": {
        "mean_heading_deg": {
          "$ref": "common.schema.json#/$defs/AngleDeg"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TapeMeasurement": {
      "description": "An optional value read from a tape by the user.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value_m"],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "wall_length",
            "ceiling_height",
            "door_height",
            "door_width",
            "window_width",
            "other"
          ]
        },
        "value_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "CapturePackage": {
      "description": "Everything the scan recorded for building the twin, uploaded as one package. Works without AR: then there is video and keyframes only, with no poses. AR poses and points are in the AR session's world frame: metres, gravity aligned, y up; the twin converts them to the space frame.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "keyframes", "detections", "sensor_log"],
      "properties": {
        "ar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tracking", "lidar", "depth"],
          "properties": {
            "tracking": {
              "type": "string",
              "enum": ["arkit", "arcore", "none"]
            },
            "lidar": {
              "type": "boolean"
            },
            "depth": {
              "type": "boolean",
              "description": "Depth images are in the package."
            }
          }
        },
        "video": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "The scan video, when recorded."
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureKeyframe"
          },
          "minItems": 1,
          "maxItems": 120
        },
        "planes": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "AR planes as JSON."
        },
        "scene_mesh": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "LiDAR scene mesh with surface classes, when the phone has LiDAR."
        },
        "depth": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "Depth images aligned to keyframes, when the phone provides them."
        },
        "detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveDetection"
          },
          "maxItems": 4000,
          "description": "Live detector results during the scan."
        },
        "sensor_log": {
          "$ref": "common.schema.json#/$defs/StorageKey",
          "description": "Motion, pose and light readings over time, as JSON lines."
        }
      }
    },
    "CaptureKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "captured_at_ms", "sharpness"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/LocalId"
        },
        "image": {
          "$ref": "common.schema.json#/$defs/StorageKey"
        },
        "captured_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds from the start of the scan."
        },
        "sharpness": {
          "type": "number",
          "minimum": 0
        },
        "pose": {
          "$ref": "#/$defs/ArPose"
        },
        "intrinsics": {
          "$ref": "space-twin.schema.json#/$defs/CameraIntrinsics"
        }
      }
    },
    "ArPoint": {
      "description": "A point in the AR session's world frame, in metres, y up.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x_m", "y_m", "z_m"],
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "z_m": {
          "type": "number"
        }
      }
    },
    "ArPose": {
      "description": "Camera pose from AR tracking: position and a unit quaternion (x, y, z, w).",
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation"],
      "properties": {
        "position": {
          "$ref": "#/$defs/ArPoint"
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "LiveDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector_class", "score", "at_ms"],
      "properties": {
        "detector_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "score": {
          "$ref": "common.schema.json#/$defs/UnitScore"
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "world": {
          "$ref": "#/$defs/ArPoint",
          "description": "Where the detection hit the AR scene, when it did."
        }
      }
    }
  }
}
