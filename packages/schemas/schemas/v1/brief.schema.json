{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sajao.app/v1/brief.schema.json",
  "title": "Brief",
  "description": "Per-room choices on top of the taste profile. With the space profile and the catalog, the only input the design engine reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "space_profile_id",
    "taste_profile_id",
    "created_at",
    "intent",
    "budget",
    "must_haves",
    "keep_item_ids",
    "consider_vastu"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "space_profile_id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "taste_profile_id": {
      "$ref": "common.schema.json#/$defs/Uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "intent": {
      "type": "string",
      "enum": ["refresh", "full_makeover", "rearrange_only"]
    },
    "budget": {
      "title": "Budget",
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "flexibility"],
      "properties": {
        "limit": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "flexibility": {
          "type": "string",
          "enum": ["strict", "stretch_10"],
          "description": "strict is never relaxed; stretch_10 allows up to 10% over."
        }
      }
    },
    "must_haves": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Product categories that must appear."
    },
    "keep_item_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/LocalId"
      },
      "description": "Existing items in the space profile to keep."
    },
    "consider_vastu": {
      "type": "boolean"
    },
    "taste_answers": {
      "title": "TasteAnswers",
      "description": "What the person answered in the app before asking for designs, as they answered it. The brief's own budget and must_haves are what the engine applies; these are the raw answers, kept for the spec and for learning taste.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/StyleProfile"
          },
          "uniqueItems": true,
          "description": "Style profiles the person picked, preferred first."
        },
        "swipes": {
          "type": "array",
          "items": {
            "title": "TasteAnswerSwipe",
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "liked"],
            "properties": {
              "card_id": {
                "type": "string",
                "minLength": 1
              },
              "liked": {
                "type": "boolean"
              }
            }
          },
          "description": "Swipe answers, in the order given."
        },
        "budget": {
          "$ref": "common.schema.json#/$defs/Money",
          "description": "The budget as the person set it."
        },
        "must_haves": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What the person said the room must have, in their words or as category keys."
        }
      }
    }
  }
}
