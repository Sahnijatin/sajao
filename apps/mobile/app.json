{
  "expo": {
    "name": "Sajao",
    "slug": "sajao",
    "scheme": "sajao",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan the space you want redone.",
        "NSPhotoLibraryUsageDescription": "Photos you choose are used to redesign your space.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": ["android.permission.CAMERA"]
    },
    "extra": {
      "eas": {
        "projectId": "7fef2ddd-9260-44b5-8a73-5e6919ac0837"
      }
    },
    "owner": "sahniijatinn"
  }
}
