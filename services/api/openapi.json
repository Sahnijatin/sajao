          },
          "upload_id": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "key",
          "upload_id",
          "parts"
        ],
        "title": "CompleteUpload",
        "type": "object"
      },
      "CompletedUpload": {
