{
  "components": {
    "schemas": {
      "AccountDeletion": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "AccountDeletion",
        "type": "object"
      },
      "Ar": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "description": "Depth images are in the package.",
            "title": "Depth",
            "type": "boolean"
          },
          "lidar": {
            "title": "Lidar",
            "type": "boolean"
          },
          "tracking": {
            "enum": [
              "arkit",
              "arcore",
              "none"
            ],
            "title": "Tracking",
            "type": "string"
          }
        },
        "required": [
          "tracking",
          "lidar",
          "depth"
        ],
        "title": "Ar",
        "type": "object"
      },
      "ArPoint": {
        "additionalProperties": false,
        "description": "A point in the AR session's world frame, in metres, y up.",
        "properties": {
          "x_m": {
            "title": "X M",
            "type": "number"
          },
          "y_m": {
            "title": "Y M",
            "type": "number"
          },
          "z_m": {
            "title": "Z M",
            "type": "number"
          }
        },
        "required": [
          "x_m",
          "y_m",
          "z_m"
        ],
        "title": "ArPoint",
        "type": "object"
      },
      "ArPose": {
        "additionalProperties": false,
        "description": "Camera pose from AR tracking: position and a unit quaternion (x, y, z, w).",
        "properties": {
          "position": {
            "$ref": "#/components/schemas/ArPoint"
          },
          "rotation": {
            "items": {
              "$ref": "#/components/schemas/RotationItem"
            },
            "maxItems": 4,
            "minItems": 4,
            "title": "Rotation",
            "type": "array"
          }
        },
        "required": [
          "position",
          "rotation"
        ],
        "title": "ArPose",
        "type": "object"
      },
      "Brief": {
        "additionalProperties": false,
        "description": "Per-room choices on top of the taste profile. With the space profile and the catalog, the only input the design engine reads.",
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "consider_vastu": {
            "title": "Consider Vastu",
            "type": "boolean"
          },
          "created_at": {
            "description": "UTC instant, RFC 3339.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "intent": {
            "enum": [
              "refresh",
              "full_makeover",
              "rearrange_only"
            ],
            "title": "Intent",
            "type": "string"
          },
          "keep_item_ids": {
            "description": "Existing items in the space profile to keep.",
            "items": {
              "$ref": "#/components/schemas/LocalId"
            },
            "title": "Keep Item Ids",
            "type": "array"
          },
          "must_haves": {
            "description": "Product categories that must appear.",
            "items": {
              "$ref": "#/components/schemas/MustHave"
            },
            "title": "Must Haves",
            "type": "array"
          },
          "schema_version": {
            "description": "Contract version of the object. Minor versions only add optional fields.",
            "pattern": "^1\\.[0-9]+$",
            "title": "Schema Version",
            "type": "string"
          },
          "space_profile_id": {
            "format": "uuid",
            "title": "Space Profile Id",
            "type": "string"
          },
          "taste_profile_id": {
            "format": "uuid",
            "title": "Taste Profile Id",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "id",
          "space_profile_id",
          "taste_profile_id",
          "created_at",
          "intent",
          "budget",
          "must_haves",
          "keep_item_ids",
          "consider_vastu"
        ],
        "title": "Brief",
        "type": "object"
      },
      "Budget": {
        "additionalProperties": false,
        "properties": {
          "flexibility": {
            "description": "strict is never relaxed; stretch_10 allows up to 10% over.",
            "enum": [
              "strict",
              "stretch_10"
            ],
            "title": "Flexibility",
            "type": "string"
          },
          "limit": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "limit",
          "flexibility"
        ],
        "title": "Budget",
        "type": "object"
      },
      "CameraIntrinsics": {
        "additionalProperties": false,
        "properties": {
          "cx": {
            "minimum": 0.0,
            "title": "Cx",
            "type": "number"
          },
          "cy": {
            "minimum": 0.0,
            "title": "Cy",
            "type": "number"
          },
          "fx": {
            "exclusiveMinimum": 0.0,
            "title": "Fx",
            "type": "number"
          },
          "fy": {
            "exclusiveMinimum": 0.0,
            "title": "Fy",
            "type": "number"
          },
          "height_px": {
            "minimum": 1.0,
            "title": "Height Px",
            "type": "integer"
          },
          "width_px": {
            "minimum": 1.0,
            "title": "Width Px",
            "type": "integer"
          }
        },
        "required": [
          "fx",
          "fy",
          "cx",
          "cy",
          "width_px",
          "height_px"
        ],
        "title": "CameraIntrinsics",
        "type": "object"
      },
      "CaptureDevice": {
        "additionalProperties": false,
        "properties": {
          "has_ar": {
            "title": "Has Ar",
            "type": "boolean"
          },
          "platform": {
            "enum": [
              "ios",
              "android"
            ],
            "title": "Platform",
            "type": "string"
          },
          "tier": {
            "description": "Device tier detected at launch.",
            "enum": [
              "standard",
              "low"
            ],
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "platform",
          "tier",
          "has_ar"
        ],
        "title": "CaptureDevice",
        "type": "object"
      },
      "CaptureKeyframe": {
        "additionalProperties": false,
        "properties": {
          "captured_at_ms": {
            "description": "Milliseconds from the start of the scan.",
            "minimum": 0.0,
            "title": "Captured At Ms",
            "type": "integer"
          },
          "id": {
            "description": "Identifier that is unique inside its parent object, for example a wall or a design item.",
            "pattern": "^[a-z0-9_-]{1,40}$",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "description": "Object key in the media store. Never a public URL; clients receive signed URLs.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Image",
            "type": "string"
          },
          "intrinsics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CameraIntrinsics"
              },
              {
                "type": "null"
              }
            ]
          },
          "pose": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ArPose"
              },
              {
                "type": "null"
              }
            ]
          },
          "sharpness": {
            "minimum": 0.0,
            "title": "Sharpness",
            "type": "number"
          }
        },
        "required": [
          "id",
          "image",
          "captured_at_ms",
          "sharpness"
        ],
        "title": "CaptureKeyframe",
        "type": "object"
      },
      "CaptureMedia": {
        "additionalProperties": false,
        "properties": {
          "compass_heading_deg": {
            "anyOf": [
              {
                "exclusiveMaximum": 360.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Degrees, 0 inclusive to 360 exclusive.",
            "title": "Compass Heading Deg"
          },
          "duration_s": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Video only.",
            "title": "Duration S"
          },
          "has_ar_pose": {
            "description": "True when an ARKit or ARCore pose is attached. Never required.",
            "title": "Has Ar Pose",
            "type": "boolean"
          },
          "height_px": {
            "minimum": 1.0,
            "title": "Height Px",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "photo",
              "video"
            ],
            "title": "Kind",
            "type": "string"
          },
          "origin": {
            "enum": [
              "camera",
              "gallery"
            ],
            "title": "Origin",
            "type": "string"
          },
          "sharpness": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "On-device sharpness check result.",
            "title": "Sharpness"
          },
          "storage_key": {
            "description": "Object key in the media store. Never a public URL; clients receive signed URLs.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Storage Key",
            "type": "string"
          },
          "width_px": {
            "minimum": 1.0,
            "title": "Width Px",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "origin",
          "storage_key",
          "width_px",
          "height_px",
          "has_ar_pose"
        ],
        "title": "CaptureMedia",
        "type": "object"
      },
      "CapturePackage": {
        "additionalProperties": false,
        "description": "Everything the scan recorded for building the twin, uploaded as one package. Works without AR: then there is video and keyframes only, with no poses. AR poses and points are in the AR session's world frame: metres, gravity aligned, y up; the twin converts them to the space frame.",
        "properties": {
          "ar": {
            "$ref": "#/components/schemas/Ar"
          },
          "depth": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Depth images aligned to keyframes, when the phone provides them.",
            "title": "Depth"
          },
          "detections": {
            "description": "Live detector results during the scan.",
            "items": {
              "$ref": "#/components/schemas/LiveDetection"
            },
            "maxItems": 4000,
            "title": "Detections",
            "type": "array"
          },
          "keyframes": {
            "items": {
              "$ref": "#/components/schemas/CaptureKeyframe"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Keyframes",
            "type": "array"
          },
          "planes": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AR planes as JSON.",
            "title": "Planes"
          },
          "review_windows": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ReviewWindow"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Times when the review was open over the scan, in milliseconds from the start of the capture. The phone was lowered then: frames of the video inside a window are not part of the scan and are dropped on the server.",
            "title": "Review Windows"
          },
          "scene_mesh": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "LiDAR scene mesh with surface classes, when the phone has LiDAR.",
            "title": "Scene Mesh"
          },
          "sensor_log": {
            "description": "Motion, pose and light readings over time, as JSON lines.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Sensor Log",
            "type": "string"
          },
          "video": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The scan video, when recorded.",
            "title": "Video"
          },
          "video_start_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the scan video's first frame was taken, in milliseconds from the start of the capture, so the video can be lined up with the keyframes and the sensor log.",
            "title": "Video Start Ms"
          }
        },
        "required": [
          "ar",
          "keyframes",
          "detections",
          "sensor_log"
        ],
        "title": "CapturePackage",
        "type": "object"
      },
      "CompassReading": {
        "additionalProperties": false,
        "description": "Compass headings averaged across the capture, used for Vastu direction.",
        "properties": {
          "mean_heading_deg": {
            "description": "Degrees, 0 inclusive to 360 exclusive.",
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Mean Heading Deg",
            "type": "number"
          },
          "sample_count": {
            "minimum": 1.0,
            "title": "Sample Count",
            "type": "integer"
          }
        },
        "required": [
          "mean_heading_deg",
          "sample_count"
        ],
        "title": "CompassReading",
        "type": "object"
      },
      "CompleteUpload": {
        "properties": {
          "key": {
            "maxLength": 128,
            "title": "Key",
            "type": "string"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/Part"
            },
            "maxItems": 10000,
            "minItems": 1,
            "title": "Parts",
